# Copy to .env and adjust. All optional — defaults are local-first.
EXO_ROOT=
EXO_VAULT=
EXO_INDEX=

# Embeddings: ollama | sentence-transformers | none
EXO_EMBED_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
EXO_EMBED_MODEL=nomic-embed-text
EXO_EMBED_DIM=768

# Hybrid fusion weights
EXO_W_BM25=1.0
EXO_W_VECTOR=1.0
EXO_W_GRAPH=0.5
