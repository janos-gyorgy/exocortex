#!/usr/bin/env sh
# Shared reconciler: rebuild the index from the vault, quietly and fast.
# Never blocks git — a failed reindex is reported, not fatal.
command -v exo >/dev/null 2>&1 || exit 0
EXO_ROOT="$(git rev-parse --show-toplevel)"
export EXO_ROOT
export EXO_EMBED_BACKEND="${EXO_EMBED_BACKEND:-none}"
if exo index >/dev/null 2>&1; then
  echo "exo: index reconciled (Synced)"
else
  echo "exo: reindex FAILED — check with 'exo status'" >&2
fi
exit 0
